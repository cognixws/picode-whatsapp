{
  "id": "whatsapp",
  "name": "WhatsApp",
  "version": "0.2.0",
  "apiVersion": 9,
  "publisher": "cognixws",
  "description": "WhatsApp Web beside your agents, fitted to narrow panels.",
  "icon": "icon.svg",
  "contributes": {
    "panels": [
      {
        "id": "web",
        "title": "WhatsApp",
        "site": {
          "url": "https://web.whatsapp.com/",
          "hosts": [
            "web.whatsapp.com"
          ],
          "recipe": {
            "styles": [
              "recipe/narrow.css"
            ],
            "expects": [
              "#app",
              "#side"
            ],
            "scripts": [
              "recipe/back.js",
              "recipe/signals.js"
            ]
          },
          "signals": [
            {
              "id": "message",
              "title": "New message",
              "fields": [
                "chat",
                "count"
              ],
              "text": "{count} unread in {chat}"
            }
          ]
        }
      }
    ]
  }
}
